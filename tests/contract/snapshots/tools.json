        "side": {
          "default": "both",
          "enum": [
            "both",
            "calls",
            "puts"
          ],
          "title": "Side",
          "type": "string"
        },
        "near_money": {
          "default": true,
          "title": "Near Money",
          "type": "boolean"
        },
        "strike_min": {
          "anyOf": [
