          "type": "string"
        },
        "since": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Since"
        },
        "max_rows": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Rows"
        },
        "provider": {
          "anyOf": [
            {
              "enum": [
                "yahoo",
                "coingecko",
                "stooq",
                "twelvedata"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider"
        }
      },
      "required": [
        "symbol"
      ],
      "title": "get_dividends_and_splitsArguments",
      "type": "object"
    },
    "annotations": {
      "title": "Get dividends and splits",
      "readOnlyHint": true,
