  {
    "name": "get_option_chain",
    "title": "Get option chain",
    "description": "Fetch calls and puts for one expiration. The default expiration is the first date the provider returns. near_money (default true) loads the last daily close from the same provider and keeps strikes within 15 percent of it. Prices and implied volatility are delayed. This is not an order. Not investment advice. Read-only.",
    "inputSchema": {
      "properties": {
        "symbol": {
          "title": "Symbol",
          "type": "string"
        },
        "expiration": {
