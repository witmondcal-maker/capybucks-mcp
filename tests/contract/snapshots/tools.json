  {
    "name": "compute_indicators",
    "title": "Compute indicators",
    "description": "Compute SMA, EMA, RSI, MACD, Bollinger bands, ATR or VWAP from a downloaded Close series. Indicator values are rounded to 6 decimals; warmup rows are null. These are textbook formulas, not a trading system. Not investment advice. Read-only.",
    "inputSchema": {
      "properties": {
        "symbol": {
          "title": "Symbol",
          "type": "string"
        },
        "indicators": {
          "anyOf": [
            {
              "items": {
                "enum": [
                  "sma",
                  "ema",
                  "rsi",
                  "macd",
                  "bollinger",
                  "atr",
                  "vwap"
                ],
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Indicators"
        },
        "period": {
          "default": "6mo",
          "title": "Period",
          "type": "string"
        },
        "interval": {
          "default": "1d",
          "title": "Interval",
          "type": "string"
        },
        "provider": {
          "anyOf": [
            {
              "enum": [
                "yahoo",
                "coingecko",
                "stooq",
                "twelvedata"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider"
        },
        "window": {
          "default": 20,
          "title": "Window",
          "type": "integer"
        },
        "rsi_window": {
          "default": 14,
          "title": "Rsi Window",
          "type": "integer"
        },
        "atr_window": {
          "default": 14,
          "title": "Atr Window",
          "type": "integer"
        },
        "macd_fast": {
          "default": 12,
          "title": "Macd Fast",
          "type": "integer"
        },
        "macd_slow": {
          "default": 26,
          "title": "Macd Slow",
          "type": "integer"
        },
        "macd_signal": {
          "default": 9,
          "title": "Macd Signal",
          "type": "integer"
        },
        "bands_std": {
          "default": 2.0,
          "title": "Bands Std",
          "type": "number"
        },
        "last_n": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last N"
