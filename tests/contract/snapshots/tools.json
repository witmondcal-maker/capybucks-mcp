      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": true
    }
  },
  {
    "name": "check_trading_day",
    "title": "Check trading day",
    "description": "Say whether a date is an exchange session. .SA maps to BVMF, .L maps to XLON, and every other symbol maps to XNYS unless calendar is set. date defaults to today in that calendar's timezone (YYYY-MM-DD). This does not say whether the market is open right now. Read-only.",
    "inputSchema": {
      "properties": {
        "symbol": {
          "title": "Symbol",
          "type": "string"
        },
        "date": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Date"
        },
        "calendar": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Calendar"
        }
      },
      "required": [
        "symbol"
      ],
      "title": "check_trading_dayArguments",
      "type": "object"
    },
    "annotations": {
      "title": "Check trading day",
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": true
    }
  }
