[
  {
    "name": "list_providers",
    "title": "List providers",
    "description": "List market-data providers, whether each needs an API key, and which datasets they support. key_configured is a boolean and never the key. Yahoo is the default equity source and is not an official API. Read-only. Not investment advice.",
    "inputSchema": {
      "properties": {},
      "title": "list_providersArguments",
      "type": "object"
    },
    "annotations": {
      "title": "List providers",
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": true
    }
  },
  {
    "name": "get_history",
    "title": "Get price history",
    "description": "Fetch OHLCV history for up to 10 symbols, one download per symbol so each series keeps its own provider, delay and asof. period is 1d, 5d, 1mo, 3mo, 6mo, 1y, 2y, 5y, 10y, max or ytd. start and end are ISO-8601; a naive value is read as UTC and, when start is set, period is ignored. view=rows (default) returns the most recent max_rows bars (default 100, ceiling 500). view=summary returns server-computed stats from Close plus the last 5 rows. Symbols containing '-' are treated as crypto unless provider is set (pass provider=yahoo for BRK-B). Yahoo Close is adjusted when auto_adjust is true. CoinGecko volume is null. Not investment advice. Read-only.",
    "inputSchema": {
      "properties": {
        "symbols": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          ],
          "title": "Symbols"
        },
        "period": {
          "default": "1mo",
          "title": "Period",
          "type": "string"
        },
        "interval": {
          "default": "1d",
          "title": "Interval",
          "type": "string"
        },
        "start": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start"
        },
        "end": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End"
        },
        "auto_adjust": {
          "default": true,
          "title": "Auto Adjust",
          "type": "boolean"
        },
        "provider": {
          "anyOf": [
            {
              "enum": [
                "yahoo",
                "coingecko",
                "stooq",
                "twelvedata"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider"
        },
        "view": {
          "default": "rows",
          "enum": [
            "rows",
            "summary"
          ],
          "title": "View",
          "type": "string"
        },
        "max_rows": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Rows"
        },
        "use_cache": {
          "default": true,
          "title": "Use Cache",
          "type": "boolean"
        }
      },
      "required": [
        "symbols"
      ],
      "title": "get_historyArguments",
      "type": "object"
    },
    "annotations": {
      "title": "Get price history",
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": true
    }
  },
  {
    "name": "get_quote",
    "title": "Get quote",
    "description": "Fetch one quote. Yahoo and CoinGecko return the last daily bar (quote_kind=last_daily_bar), not a live price. Twelve Data stamps timestamp with the time of the call (quote_kind=provider_quote). delayed is part of the payload. Not investment advice. Read-only.",
    "inputSchema": {
      "properties": {
        "symbol": {
          "title": "Symbol",
          "type": "string"
        },
        "provider": {
          "anyOf": [
            {
              "enum": [
                "yahoo",
                "coingecko",
                "stooq",
                "twelvedata"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider"
        }
      },
      "required": [
        "symbol"
      ],
      "title": "get_quoteArguments",
      "type": "object"
    },
    "annotations": {
      "title": "Get quote",
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": true
    }
  },
  {
    "name": "get_financials",
    "title": "Get financial statements",
    "description": "Fetch an income statement, balance sheet or cash-flow statement, annual or quarterly. Line-item names stay as the provider wrote them (totalRevenue on Yahoo is not revenue on Twelve Data). Pass items to keep a case-insensitive subset. An empty statement is an error, not zeros. CoinGecko and Stooq do not support statements. Not investment advice. Read-only.",
    "inputSchema": {
      "properties": {
        "symbol": {
          "title": "Symbol",
          "type": "string"
        },
        "statement": {
          "default": "income",
          "enum": [
            "income",
            "balance",
            "cashflow"
          ],
          "title": "Statement",
          "type": "string"
        },
        "frequency": {
          "default": "annual",
          "enum": [
            "annual",
            "quarterly"
          ],
          "title": "Frequency",
          "type": "string"
        },
        "provider": {
          "anyOf": [
            {
              "enum": [
                "yahoo",
                "coingecko",
                "stooq",
                "twelvedata"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider"
        },
        "items": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Items"
        },
        "max_periods": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Periods"
        }
      },
      "required": [
        "symbol"
      ],
      "title": "get_financialsArguments",
      "type": "object"
    },
    "annotations": {
      "title": "Get financial statements",
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": true
    }
  },
  {
    "name": "get_dividends_and_splits",
